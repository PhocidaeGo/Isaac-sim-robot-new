  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="robco_joint_5">
  <sensor type="force_torque" name="ft_sensor">
    <!-- Configure sensor properties -->
    <update_rate>100</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <topic>~/ft_sensor</topic>
    <pose>0 0 0 0 0 0</pose>
    <gz_frame_id>shield_1</gz_frame_id>

    <!-- ForceTorque-specific settings -->
    <force_torque>
      <!-- Typically 'child' or 'parent'. This sets which frame is reported. -->
      <frame>parent</frame>
      <!-- Direction of measurement: 'child_to_parent' or 'parent_to_child' -->
      <measure_direction>child_to_parent</measure_direction>
    </force_torque>
  </sensor>
</gazebo>

<gazebo reference="nozzle_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="ouster_lidar_frame">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="RGLsensor" type="custom">
    <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
      <range>
          <min>0</min>
          <max>100</max>
      </range>
      <update_rate>10</update_rate>a
      <update_on_paused_sim>false</update_on_paused_sim>
      <topic>sim_ouster/points</topic>
      <frame>ouster_lidar_frame</frame>
      <!-- <pattern_preset>OS1 64</pattern_preset> -->
      <pattern_uniform>
        <horizontal>
            <samples>1024</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
        </horizontal>
        <vertical>
            <samples>128</samples>
            <min_angle>-0.7853975</min_angle>
            <max_angle>0.7853975</max_angle>
        </vertical>
    </pattern_uniform>
    </plugin>
  </sensor>
  <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>500</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <gz_frame_id>ouster_lidar_frame</gz_frame_id>
  </sensor>
  </gazebo>

  <gazebo reference="camera">
    <sensor name="camera_sensor" type="camera">
      <pose>0 0 0 1.5708 -1.5708 0</pose>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <gz_frame_id>camera</gz_frame_id>
      <!-- Attach the ROS2 plugin -->
      <plugin filename="ImageDisplay" name="Image Display">      <!-- Plugin parameters (adjust these as needed) -->
        <cameraName>camera_sensor</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <!-- (Optionally add additional parameters like frame rate or frame id) -->
      </plugin>
    </sensor>
  </gazebo>

</robot>
