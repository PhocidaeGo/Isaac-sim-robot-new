<?xml version="1.0" ?>
<robot name="mobile_robco" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="robco_joint_0_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="robco_joint_0">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="robco_joint_0_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

