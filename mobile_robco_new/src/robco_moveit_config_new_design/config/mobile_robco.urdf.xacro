<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robco">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mobile_robco urdf file -->
    <xacro:include filename="$(find mobile_robco_description)/urdf/mobile_robco.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="mobile_robco.ros2_control.xacro" />


    <xacro:mobile_robco_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
